rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 유저 데이터: 본인 UID 문서만 읽기/쓰기 가능 (FirebaseManager.cs LoadUserData/SaveUserData)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 문의 메일: 로그인한 클라이언트가 생성만 가능, 읽기/수정/삭제 불가
    // (Trigger Email 확장이 서버 측에서 처리 — SendInquiryAsync)
    match /mail/{mailId} {
      allow create: if request.auth != null
        && request.resource.data.to == "oortcloud98@gmail.com"
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() < 3000;
      allow read, update, delete: if false;
    }

    // 그 외 모든 컬렉션은 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
